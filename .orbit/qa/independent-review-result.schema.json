{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit Independent Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict", "score", "summary", "findings", "criteria", "recommendations"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "verdict": { "type": "string", "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED"] },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Overall quality on a 0-10 scale, where 10 is flawless. NOT a percentage - a value above 10 is invalid and the review will be rejected."
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "body", "file", "line", "criterion_ids"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "criterion_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "CONCERNS", "WAIVED"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } }
  }
}
