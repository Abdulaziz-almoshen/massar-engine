{
  "name": "massar-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Massar WhatsApp AI campaign engine — Gupshup gateway + Arabic sales agent (MVP spine)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "./.venv/bin/python scripts/smoke.py",
    "deploy": "npm run check && fly deploy --ha=false && npm run smoke",
    "smoke:setup": "python3 -m venv .venv && ./.venv/bin/pip -q install playwright && ./.venv/bin/python -m playwright install chromium",
    "check:catalogue": "node scripts/check-catalogue.mjs",
    "check:numerals": "node scripts/check-numerals.mjs",
    "check:buttons": "npm run build && node scripts/check-buttons.mjs",
    "check": "npm run test && npm run check:catalogue && npm run check:numerals && npm run check:buttons && npm run check:campaigns && npm run check:optout && npm run check:ae && npm run check:productlock && npm run check:sendable && npm run check:btnforce && npm run check:voice && npm run check:contactwin && npm run check:outcomes && npm run check:props && npm run check:crm && npm run check:facts && npm run check:crmlit && npm run check:writers && npm run check:authz",
    "check:crm": "npm run build && node scripts/check-crm.mjs",
    "check:optout": "npm run build && node scripts/check-optout.mjs",
    "check:campaigns": "npm run build && node scripts/check-campaign-scope.mjs",
    "check:ae": "npm run build && node scripts/check-ae-prompt.mjs",
    "check:productlock": "npm run build && node scripts/check-productlock.mjs",
    "check:sendable": "npm run build && node scripts/check-sendable.mjs",
    "check:btnforce": "npm run build && node scripts/check-buttons-enforced.mjs",
    "check:voice": "npm run build && node scripts/check-salesvoice.mjs",
    "check:contactwin": "npm run build && node scripts/check-contactwin.mjs",
    "check:outcomes": "npm run build && node scripts/check-outcomes.mjs",
    "check:props": "npm run build && node scripts/check-props.mjs",
    "check:facts": "npm run build && node scripts/check-facts.mjs",
    "qa:scale": "./.venv/bin/python scripts/qa-scale.py",
    "test": "vitest run --coverage",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:local@127.0.0.1:5433/massar_test} vitest run tests/db.integration.test.ts",
    "db:up": "docker start massar-local-pg 2>/dev/null || docker run -d --name massar-local-pg -e POSTGRES_PASSWORD=local -e POSTGRES_DB=massar -p 5433:5432 postgres:16",
    "test:watch": "vitest",
    "check:authz": "npm run build && node scripts/check-authz.mjs",
    "check:writers": "node scripts/check-ledger-writers.mjs",
    "check:crmlit": "npm run build && node scripts/check-crm-literals.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@firecrawl/anydoc": "^0.1.8",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "openai": "^5.10.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
