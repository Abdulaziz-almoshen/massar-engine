# --- OpenAI (the Arabic sales agent) ---
OPENAI_API_KEY=
# Optional: pin a model id. Leave empty to auto-pick the best available at boot.
OPENAI_MODEL=

# --- Gupshup (WhatsApp BSP) ---
GUPSHUP_API_KEY=
GUPSHUP_APP_ID=
# App name as shown in the Gupshup dashboard. Auto-learned from the first webhook if empty.
GUPSHUP_APP_NAME=
# The app's WhatsApp business number, digits only with country code (e.g. 9665XXXXXXXX).
# REQUIRED for outbound sends.
GUPSHUP_SOURCE_NUMBER=

# --- Service secrets ---
# Appended to the webhook URL as ?token=... (Gupshup callbacks are unsigned).
WEBHOOK_TOKEN=
# Required header x-admin-token for /admin/* endpoints.
ADMIN_TOKEN=

PORT=8080
